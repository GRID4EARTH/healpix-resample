notebooks/outputFLUX.grib.*.idx
tmp/zenodo-*/

# LaTeX build artefacts. Regenerated by pdflatex/bibtex on every compile;
# main.bbl is included because references.bib is tracked and bibtex rebuilds it.
tex/*.aux
tex/*.bbl
tex/*.blg
tex/*.log
tex/*.out
tex/*.toc
tex/*.synctex.gz
tex/main.pdf
tex/_preview.pdf
tex/main_*.pdf

# Zenodo archives built by notebooks/build_zenodo_archives.py (dist/ is
# already ignored above, listed here so the intent is explicit).
# dist/

# Real Sentinel-2 region patches: frozen inputs, distributed through Zenodo.
notebooks/data/multi_patch_sentinel2/
